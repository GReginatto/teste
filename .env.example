
# ── Desafio 1 — N8N ──────────────────────────────────────────────────────────
# Definir no ambiente antes de iniciar o N8N: $env:VARIAVEL="valor" (PowerShell)
GEMINI_API_KEY=AQ.xxx
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...          # usado pelo N8N via $env.SUPABASE_ANON_KEY
NOTIFICATION_WEBHOOK_URL=https://webhook.site/seu-id

# ── Desafio 2 — Python ───────────────────────────────────────────────────────
DATABASE_BACKEND=sqlite                # padrão: sqlite | supabase | postgres

SUPABASE_KEY=eyJhbGci...              # usado pelo Python — mesmo valor que SUPABASE_ANON_KEY acima
DATABASE_URL=postgresql://user:password@host:5432/dbname   # apenas se DATABASE_BACKEND=postgres

# ── ClickUp — produção (Desafio 2) ───────────────────────────────────────────
CLICKUP_API_TOKEN=pk_...
CLICKUP_LIST_ID=90000000
CLICKUP_ASSIGNEE_ID=12345678
